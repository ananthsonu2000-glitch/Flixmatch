# Google Gemini API key — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# TMDB API key (v3 auth) — free account at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# RapidAPI key subscribed to the "OTT details" API, which returns IMDb rating
# + Indian OTT platform links by IMDb id: https://rapidapi.com/gox-ai-gox-ai-default/api/ott-details
RAPIDAPI_KEY=
RAPIDAPI_HOST=ott-details.p.rapidapi.com

# Supabase project — create one at https://supabase.com/dashboard, then run
# supabase/schema.sql in the SQL editor before starting the app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, NEVER expose to the client/browser
SUPABASE_SERVICE_ROLE_KEY=
